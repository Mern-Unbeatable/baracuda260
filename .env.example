# ── App ────────────────────────────────────────────────────────
VITE_NAME=My12Photos
VITE_VERSION=1.0.0

# ── API ────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_TIMEOUT=10000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000

# ── Analytics / Web Vitals ─────────────────────────────────────
VITE_VITALS_ENDPOINT=https://vitals.vercel-analytics.com/v1/vitals

# ── SEO ────────────────────────────────────────────────────────
VITE_SEO_TITLE=My12Photos
VITE_SEO_DESCRIPTION=A professional React application
VITE_SEO_KEYWORDS=react,vite,tailwind

# VITE_DEV_PORT=5173

# ── WebSocket ──────────────────────────────────────────────────
# Defaults to VITE_API_BASE_URL when not set
VITE_SOCKET_URL=https://api.yourdomain.com

# ── Local dev helpers (optional) ───────────────────────────────
# VITE_DEV_MOCK_AUTH=true
# VITE_DEV_DEFAULT_EMAIL=demo@example.com
# VITE_DEV_DEFAULT_PASSWORD=demo

# Legacy REACT_APP_* names still work during migration.
